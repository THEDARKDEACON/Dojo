<?xml version="1.0"?>
<package format="3">
  <name>robot_control</name>
  <version>1.0.0</version>
  <description>ROS 2 control system for the robot, including motor control, odometry, and low-level hardware interfaces.</description>
  <maintainer email="garethjoel@example.com">Gareth Joel</maintainer>
  <license>Apache-2.0</license>
  
  <author>Dojo Development Team</author>
  <url type="website">https://github.com/yourorg/dojo_robot</url>
  <url type="bugtracker">https://github.com/yourorg/dojo_robot/issues</url>
  <url type="repository">https://github.com/yourorg/dojo_robot</url>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <!-- Core ROS 2 dependencies -->
  <depend>rclcpp</depend>
  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>tf2_ros</depend>
  
  <!-- Control dependencies -->
  <depend>controller_interface</depend>
  <depend>controller_manager</depend>
  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>realtime_tools</depend>
  
  <!-- Hardware specific -->
  <depend>libserial-dev</depend>
  
  <!-- For parameter handling -->
  <depend>rcl_interfaces</depend>
  
  <!-- For diagnostics -->
  <depend>diagnostic_updater</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>launch_testing_ament_cmake</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
