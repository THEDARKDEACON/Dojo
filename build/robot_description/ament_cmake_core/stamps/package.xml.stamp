<?xml version="1.0"?>
<package format="3">
  <name>robot_description</name>
  <version>1.0.0</version>
  <description>URDF and Xacro description of the Dojo robot with Gazebo support</description>
  <maintainer email="garethjoel@example.com">Gareth Joel</maintainer>
  <license>Apache-2.0</license>
  
  <author>Dojo Development Team</author>
  <url type="website">https://github.com/yourorg/dojo_robot</url>
  <url type="bugtracker">https://github.com/yourorg/dojo_robot/issues</url>
  <url type="repository">https://github.com/yourorg/dojo_robot</url>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <buildtool_depend>ros_environment</buildtool_depend>

  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>urdf</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>urdfdom_py</exec_depend>
  <exec_depend>gazebo_ros2_control</exec_depend>
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>hardware_interface</exec_depend>
  <exec_depend>pluginlib</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>launch_testing_ament_cmake</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <buildtool_depend>ros_environment</buildtool_depend>
    <build_export_depend>ros_environment</build_export_depend>
    <exec_depend>ros_environment</exec_depend>
    <build_export_depend>urdf xacro</build_export_depend>
  </export>
</package>
