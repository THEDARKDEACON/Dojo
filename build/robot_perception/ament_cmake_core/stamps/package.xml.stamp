<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_perception</name>
  <version>0.2.0</version>
  <description>Advanced robot perception package with camera, LiDAR, and sensor fusion capabilities</description>
  <maintainer email="robosync@example.com">robosync</maintainer>
  <license>Apache-2.0</license>
  <url type="website">https://github.com/yourusername/robot_perception</url>
  <url type="repository">https://github.com/yourusername/robot_perception.git</url>
  <url type="bugtracker">https://github.com/yourusername/robot_perception/issues</url>

  <!-- Build tool dependencies -->
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <buildtool_depend>python_cmake_module</buildtool_depend>
  <buildtool_depend>python3-setuptools</buildtool_depend>

  <!-- Build dependencies -->
  <build_depend>rclpy</build_depend>
  <build_depend>std_msgs</build_depend>
  <build_depend>builtin_interfaces</build_depend>
  <build_depend>sensor_msgs</build_depend>
  <build_depend>sensor_msgs_py</build_depend>
  <build_depend>vision_msgs</build_depend>
  <build_depend>laser_geometry</build_depend>
  <build_depend>geometry_msgs</build_depend>
  <build_depend>tf2_ros</build_depend>
  <build_depend>tf2_geometry_msgs</build_depend>
  <build_depend>cv_bridge</build_depend>
  <build_depend>image_geometry</build_depend>
  <build_depend>image_transport</build_depend>
  <build_depend>camera_info_manager</build_depend>
  <build_depend>visualization_msgs</build_depend>
  <build_depend>rqt_image_view</build_depend>
  <build_depend>rviz2</build_depend>

  <!-- Build and exec dependencies -->
  <build_export_depend>rclpy</build_export_depend>
  <build_export_depend>sensor_msgs</build_export_depend>
  <build_export_depend>sensor_msgs_py</build_export_depend>
  <build_export_depend>vision_msgs</build_export_depend>
  <build_export_depend>geometry_msgs</build_export_depend>
  <build_export_depend>tf2_ros</build_export_depend>
  <build_export_depend>tf2_geometry_msgs</build_export_depend>
  <build_export_depend>cv_bridge</build_export_depend>
  <build_export_depend>image_transport</build_export_depend>
  <build_export_depend>visualization_msgs</build_export_depend>

  <!-- Runtime dependencies -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>builtin_interfaces</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>sensor_msgs_py</exec_depend>
  <exec_depend>vision_msgs</exec_depend>
  <exec_depend>laser_geometry</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>tf2_geometry_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>image_geometry</exec_depend>
  <exec_depend>image_transport</exec_depend>
  <exec_depend>camera_info_manager</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>rqt_image_view</exec_depend>
  <exec_depend>rviz2</exec_depend>
  
  <!-- Python dependencies -->
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-scikit-learn</exec_depend>
  
  <!-- Optional deep learning dependencies -->
  <exec_depend condition="$ROS_PYTHON_VERSION == 3">python3-torch</exec_depend>
  <exec_depend condition="$ROS_PYTHON_VERSION == 3">python3-torchvision</exec_depend>
  <exec_depend condition="$ROS_PYTHON_VERSION == 3">ultralytics</exec_depend>
  <exec_depend condition="$ROS_PYTHON_VERSION == 3">onnxruntime</exec_depend>
  
  <!-- Documentation dependencies -->
  <doc_depend>python3-sphinx</doc_depend>
  <doc_depend>python3-sphinx-rtd-theme</doc_depend>
  
  <!-- Test dependencies -->
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>python3-pytest-cov</test_depend>
  <test_depend>python3-pytest-mock</test_depend>
  
  <!-- Export information -->
  <export>
    <build_type>ament_cmake</build_type>
    <build_type>ament_python</build_type>
    
    <!-- Python package data -->
    <python_package>
      <packages>
        <package>robot_perception</package>
        <package>robot_perception.nodes</package>
        <package>robot_perception.utils</package>
      </packages>
    </python_package>
  </export>
</package>
