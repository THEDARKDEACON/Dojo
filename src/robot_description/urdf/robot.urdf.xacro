<?xml version="1.0"?>
<robot name="zeta" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Constants -->
  <xacro:property name="M_PI" value="3.1415926535897931" />
  <xacro:property name="M_PI_2" value="1.5707963267948966" />
  
  <!-- Robot Parameters -->
  <xacro:property name="base_x" value="0.28" />
  <xacro:property name="base_y" value="0.23" />
  <xacro:property name="base_z" value="0.07" />
  <xacro:property name="wheel_radius" value="0.0325" />
  <xacro:property name="wheel_width" value="0.03" />
  <xacro:property name="wheel_separation" value="0.26" />
  
  <!-- Materials -->
  <material name="grey">
    <color rgba="0.7 0.7 0.7 1"/>
  </material>
  <material name="green">
    <color rgba="0 0.6 0 1"/>
  </material>
  <material name="white">
    <color rgba="1 1 1 1"/>
  </material>
  <material name="black">
    <color rgba="0.1 0.1 0.1 1"/>
  </material>
  
  <!-- Gazebo materials removed to avoid Ogre2 material conflicts -->
  
  <!-- Base link -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="${base_x} ${base_y} ${base_z}"/>
      </geometry>
      <origin xyz="0 0 0.035" rpy="0 0 0"/>
      <material name="green"/>
    </visual>
    <collision>
      <geometry>
        <box size="${base_x} ${base_y} ${base_z}"/>
      </geometry>
      <origin xyz="0 0 0.035" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="1.5"/>
      <inertia ixx="0.003" ixy="0.0" ixz="0.0"
               iyy="0.002" iyz="0.0"
               izz="0.003"/>
    </inertial>
  </link>

  <!-- Top floor -->
  <link name="top_floor">
    <visual>
      <geometry>
        <box size="0.15 0.085 0.038"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="green"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.15 0.085 0.038"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.3"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0"
               iyy="0.0001" iyz="0.0"
               izz="0.0001"/>
    </inertial>
  </link>

  <!-- Joint between base and top floor -->
  <joint name="base_top_floor_joint" type="fixed">
    <parent link="base_link"/>
    <child link="top_floor"/>
    <origin xyz="0 0 0.085" rpy="0 0 0"/>
  </joint>

  <!-- Drive Wheel Macro -->
  <xacro:macro name="wheel" params="prefix x y z">
    <link name="${prefix}_wheel">
      <visual>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <origin xyz="0 0 0" rpy="${M_PI_2} 0 0"/>
        <material name="grey"/>
      </visual>
      <collision>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <origin xyz="0 0 0" rpy="${M_PI_2} 0 0"/>
      </collision>
      <inertial>
        <mass value="0.1"/>
        <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
      </inertial>
    </link>

    <joint name="base_${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel"/>
      <origin xyz="${x} ${y} ${z}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <!-- Caster Wheel Macro -->
  <xacro:macro name="caster" params="prefix x y z">
    <link name="${prefix}_caster">
      <visual>
        <geometry>
          <sphere radius="0.015"/>
        </geometry>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <material name="black"/>
      </visual>
      <collision>
        <geometry>
          <sphere radius="0.015"/>
        </geometry>
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </collision>
      <inertial>
        <mass value="0.05"/>
        <inertia ixx="0.00001" ixy="0.0" ixz="0.0" iyy="0.00001" iyz="0.0" izz="0.00001"/>
      </inertial>
    </link>

    <joint name="base_${prefix}_caster_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${prefix}_caster"/>
      <origin xyz="${x} ${y} ${z}" rpy="0 0 0"/>
    </joint>

    <!-- Gazebo caster properties for low friction -->
    <gazebo reference="${prefix}_caster">
      <mu1>0.1</mu1>
      <mu2>0.1</mu2>
      <kp>1000000.0</kp>
      <kd>100.0</kd>
      <minDepth>0.001</minDepth>
      <maxVel>1.0</maxVel>
    </gazebo>
  </xacro:macro>

  <!-- Create front drive wheels (motorized) -->
  <xacro:wheel prefix="front_left" x="0.1075" y="0.13" z="0"/>
  <xacro:wheel prefix="front_right" x="0.1075" y="-0.13" z="0"/>
  
  <!-- Create rear caster wheels (low friction, easy turning) -->
  <xacro:caster prefix="rear_left" x="-0.1075" y="0.13" z="-0.0175"/>
  <xacro:caster prefix="rear_right" x="-0.1075" y="-0.13" z="-0.0175"/>

  <!-- Lidar -->
  <link name="lidar">
    <visual>
      <geometry>
        <cylinder radius="0.03" length="0.02"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="white"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.03" length="0.05"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="base_lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar"/>
    <origin xyz="0 0 0.103" rpy="0 0 0"/>
  </joint>

  <!-- Camera -->
  <link name="camera_link">
    <visual>
      <geometry>
        <box size="0.01 0.01 0.01"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.01 0.01 0.01"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.00001" ixy="0.0" ixz="0.0" iyy="0.00001" iyz="0.0" izz="0.00001"/>
    </inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="top_floor"/>
    <child link="camera_link"/>
    <origin xyz="0.08 0 0.01" rpy="0 0 0"/>
  </joint>

  <!-- Gazebo Harmonic Camera Sensor - Temporarily disabled to avoid Ogre2 rendering issues -->
  <!-- 
  <gazebo reference="camera_link">
    <sensor type="camera" name="camera1">
      <update_rate>30.0</update_rate>
      <camera name="front">
        <horizontal_fov>1.3962634</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>100</far>
        </clip>
      </camera>
      <always_on>true</always_on>
      <update_rate>30.0</update_rate>
      <visualize>false</visualize>
    </sensor>
  </gazebo>
  -->

  <!-- Gazebo Harmonic 2D Laser Scanner - Full 360-degree coverage for SLAM -->
  <gazebo reference="lidar">
    <sensor name="lidar_sensor" type="gpu_ray">
      <pose>0 0 0 0 0 0</pose>
      <topic>lidar</topic>
      <update_rate>10.0</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1.0</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.1</min>
          <max>10.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <always_on>true</always_on>
      <visualize>true</visualize>
    </sensor>
  </gazebo>

  <!-- Gazebo Harmonic Differential Drive Plugin for Front-Wheel Drive -->
  <gazebo>
    <plugin filename="gz-sim8-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>base_front_left_wheel_joint</left_joint>
      <right_joint>base_front_right_wheel_joint</right_joint>
      <wheel_separation>${wheel_separation}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <odom_publish_frequency>50.0</odom_publish_frequency>
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <max_angular_acceleration>2.0</max_angular_acceleration>
      <max_linear_velocity>0.5</max_linear_velocity>
      <max_angular_velocity>1.0</max_angular_velocity>
    </plugin>
    
    <!-- Joint State Publisher for wheel positions -->
    <plugin filename="gz-sim8-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
    </plugin>
    
    <!-- Sensors System for LiDAR and Camera - Using Ogre instead of Ogre2 -->
    <plugin filename="gz-sim8-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre</render_engine>
    </plugin>
    
    <!-- Pose Publisher disabled - using DiffDrive plugin for odometry instead -->
    <!-- 
    <plugin filename="gz-sim8-pose-publisher-system" name="gz::sim::systems::PosePublisher">
      <publish_link_pose>false</publish_link_pose>
      <use_pose_vector_msg>false</use_pose_vector_msg>
      <static_publisher>false</static_publisher>
    </plugin>
    -->
  </gazebo>
</robot>
