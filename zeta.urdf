<?xml version="1.0"?>
 <robot name="zeta"> 

  <!-- Materials -->
  <material name="grey">
    <color rgba="0.7 0.7 0.7 1"/>
  </material>
  <material name="green">
    <color rgba="0 0.6 0 1"/>
  </material>
  <material name="white">
    <color rgba="1 1 1 1"/>
  </material>

  <!-- Gazebo materials -->
  <gazebo reference="base_link">
    <material>Gazebo/Green</material>
  </gazebo>

  <gazebo reference="top_floor">
    <material>Gazebo/Green</material>
  </gazebo>

  <gazebo reference="lidar">
    <material>Gazebo/White</material>
  </gazebo>

  <gazebo reference="left_wheel">
    <material>Gazebo/Grey</material>
  </gazebo>

  <gazebo reference="right_wheel">
    <material>Gazebo/Grey</material>
  </gazebo>

  <gazebo reference="frontright_wheel">
    <material>Gazebo/Grey</material>
  </gazebo>

  <gazebo reference="frontleft_wheel">
    <material>Gazebo/Grey</material>
  </gazebo> 

  <!-- Base link -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.28 0.23 0.07"/>
      </geometry>
      <origin xyz="0 0 0.035" rpy="0 0 0"/>
      <material name="green"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.28 0.23 0.07"/>
      </geometry>
      <origin xyz="0 0 0.035" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="1.5"/>
      <inertia ixx="0.003" ixy="0.0" ixz="0.0"
               iyy="0.002" iyz="0.0"
               izz="0.003"/>
    </inertial>
  </link>

  <!-- Top floor -->
  <link name="top_floor">
    <visual>
      <geometry>
        <box size="0.15 0.085 0.038"/>    
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="green"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.15 0.085 0.038"/>    
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.3"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0"
               iyy="0.0001" iyz="0.0"
               izz="0.0001"/>
    </inertial>
  </link>

  <!-- Lidar -->
  <link name="lidar">
    <visual>
      <geometry>
        <cylinder radius="0.033" length="0.018"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="white"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.033" length="0.018"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.00001" ixy="0.0" ixz="0.0"
               iyy="0.00001" iyz="0.0"
               izz="0.00001"/>
    </inertial>
  </link>

  <!-- Wheels -->
  <link name="left_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.0325" length="0.03"/>
      </geometry>
      <origin xyz="0 0 0" rpy="1.57 0 0"/>
      <material name="grey"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.0325" length="0.03"/>
      </geometry>
      <origin xyz="0 0 0" rpy="1.57 0 0"/>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0"
               iyy="0.0002" iyz="0.0"
               izz="0.0001"/>
    </inertial>
  </link>

  <link name="right_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.0325" length="0.03"/>
      </geometry>
      <origin xyz="0 0 0" rpy="1.57 0 0"/>
      <material name="grey"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.0325" length="0.03"/>
      </geometry>
      <origin xyz="0 0 0" rpy="1.57 0 0"/>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0"
               iyy="0.0002" iyz="0.0"
               izz="0.0001"/>
    </inertial>
  </link>

  <link name="frontright_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.0325" length="0.03"/>
      </geometry>
      <origin xyz="0 0 0" rpy="1.57 0 0"/>
      <material name="grey"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.0325" length="0.03"/>
      </geometry>
      <origin xyz="0 0 0" rpy="1.57 0 0"/>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0"
               iyy="0.0002" iyz="0.0"
               izz="0.0001"/>
    </inertial>
  </link>

  <link name="frontleft_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.0325" length="0.03"/>
      </geometry>
      <origin xyz="0 0 0" rpy="1.57 0 0"/>
      <material name="grey"/>
    </visual> 
    <collision>
      <geometry>
        <cylinder radius="0.0325" length="0.03"/>
      </geometry>
      <origin xyz="0 0 0" rpy="1.57 0 0"/>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0"
               iyy="0.0002" iyz="0.0"
               izz="0.0001"/>
    </inertial>
  </link>

  <!-- Joints -->
  <joint name="base_top_floor_joint" type="fixed">
    <parent link="base_link"/>
    <child link="top_floor"/>
    <origin xyz="0 0 0.085" rpy="0 0 0"/>
  </joint>

  <joint name="base_lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar"/>
    <origin xyz="0 0 0.103" rpy="0 0 0"/>
  </joint>
   
  <joint name="base_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="-0.1075 0.13 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint> 

  <joint name="base_right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="-0.1075 -0.13 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <joint name="base_frontright_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="frontright_wheel"/>
    <origin xyz="0.1075 -0.13 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <joint name="base_frontleft_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="frontleft_wheel"/>
    <origin xyz="0.1075 0.13 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Gazebo Differential Drive Plugin -->
  <gazebo>
    <plugin name="differential_drive_controller" filename="libgazebo_ros_diff_drive.so">
      <!-- ROS Topics -->
      <commandTopic>cmd_vel</commandTopic>
      <odometryTopic>odom</odometryTopic>
      <odometryFrame>odom</odometryFrame>
      
      <!-- Robot Frames -->
      <robotBaseFrame>base_link</robotBaseFrame>
      
      <!-- Wheel Configuration -->
      <leftJoint>base_left_wheel_joint</leftJoint>
      <leftJoint>base_frontleft_wheel_joint</leftJoint>
      <rightJoint>base_right_wheel_joint</rightJoint>
      <rightJoint>base_frontright_wheel_joint</rightJoint>
      
      <!-- Kinematic Parameters -->
      <wheelSeparation>0.26</wheelSeparation>
      <wheelDiameter>0.065</wheelDiameter>
      
      <!-- Physics Parameters -->
      <torque>0.5</torque>
      <publishOdom>true</publishOdom>
      <publishWheelTF>true</publishWheelTF>
      <publishOdomTF>true</publishOdomTF>
    </plugin>
  </gazebo>

</robot>

